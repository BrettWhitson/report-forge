{
  "name": "report-forge",
  "version": "0.1.0",
  "private": true,
  "description": "Merge tabular data into HTML templates and produce PDFs in bulk.",
  "scripts": {
    "test": "node --test test/",
    "preview": "node scripts/preview.js",
    "render-test": "electron scripts/render-test.js",
    "start": "electron .",
    "dist": "electron-builder --win portable && node scripts/copy-templates.js"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "mustache": "^4.2.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "main": "main/main.js",
  "build": {
    "appId": "local.reportforge.app",
    "productName": "Report Forge",
    "files": [
      "main/**",
      "lib/**",
      "ui/**",
      "package.json"
    ],
    "directories": {
      "output": "../dist"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "Report Forge ${version}.exe"
    }
  }
}
